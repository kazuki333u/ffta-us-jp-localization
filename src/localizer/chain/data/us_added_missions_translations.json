{
 "_public_note": "Public build manifest. Verbatim retail source strings are stored as SHA-256 digests (fields ending in _sha256); the builder recomputes them from the user's own ROM. Japanese text in this file is written by this project.",
 "_note": "Editorial decision of record for the US-added placeholder-transfer family: the twenty US-added missions' names (words:quest 377..396) and briefings (pages:quest/1 176..195), the Official unit kind (words:content/122) and its description (fx_text/22/121). JP retail ships developer placeholders in these slots (クエスト377, ダミー377, 予備2, empty), so the JP bytes are not a translation; this manifest is. Consumed and revalidated on every build by ffta_jp_us_added_missions.py. Markup: {HEX} is a CTR_FUNC operand; every other character is text.",
 "milestone": "us_added_missions",
 "description": "US-added placeholder-transfer family (RC16 finding, ffta_placeholder_transfer_audit.py): 42 records that RC12 still ships as JP developer placeholders, localized from the US retail originals.",
 "baseline_production_sha256": "9098F025FDDD00119E0FD833199F5E9BBD1F66DCBEAD865D60749C3C4E652532",
 "count": 42,
 "translated_count": 42,
 "no_change_required_count": 0,
 "families": {
  "words:quest": 20,
  "pages:quest/1": 20,
  "words:content": 1,
  "fx_text/22": 1
 },
 "root_cause": "ffta_jp_us_only_editorial_scope.py treats a US record as US-only only when the aligned JP record is missing or empty. These JP records are non-empty developer placeholders (クエスト<n>, ダミー<n>, 予備2), so source transfer 'succeeded' and shipped the placeholder. Policy (Main docs/decisions.md, 2026-09-01): JP retail is the authority for player-visible wording, not for developer placeholders.",
 "lane": "CHR_FULL for every written entry; every glyph is a native JP record the production font already carries (zero new glyphs)",
 "width_policy": {
  "rule": "per-family bound = the widest single rendered line among that family's own JP originals, measured with the JP font advance metadata; lines per record bounded by the family's JP maximum",
  "words:quest": "<= 87 px (JP words:quest/66); the pub mission list column",
  "words:content": "<= 86 px (JP words:content/507)",
  "pages:quest/1": "<= 192 px per line (JP pages:quest ordinal 12) and <= 7 lines (JP maximum, 6 in practice: five body lines and the {1D10} requester line); encoded payload <= the longest JP original of the leaf (renderer buffer)",
  "fx_text/22": "<= 192 px per line and <= 2 lines per page (JP fx_text/22 originals)"
 },
 "control_policy": {
  "preserved": "every reference control of the US original ({400} the player's name, {51xx} character / word references such as {5109} バブズ, {510A} エゼル, {5104} リッツ, {5103} ミュート, {5106} シド, {5107} ドネッド, {5117} ジャッジ), the {1D10} requester-line indent JP retail's own briefings use, and the trailing close sequence ({42} for briefings, {40}{42} for the description)",
  "dropped": "the English word space {52} and the justification controls {1D02}/{1D03}/{1D04}; line breaks {4D} are re-flowed to Japanese line lengths; the mid-record page break of fx_text/22/121 is dropped because the two-line JP shape needs none",
  "mission_panel_invariant": "the briefing records carry no {04 xx} substitution token; they are the value a template's {04 xx} consumes, so the RC12 template-slot rule does not apply to them -- the shape (<= 6 lines, <= 192 px, {42} terminator) is what JP retail's own briefings give the same renderer"
 },
